# App Configuration
PROJECT_NAME="AI Learning Path Copilot"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/learning_copilot"
# Sync database url if needed for migrations/scripts
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learning_copilot"

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# AI Provider API Keys (Optional for mock phase, needed for real AI layer)
OPENAI_API_KEY="your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"
